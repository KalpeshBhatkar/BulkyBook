@model IEnumerable<Product>
@{
    ViewData["Title"] = "Home Page";
}
<partial name="_Hero" />

<!-- Catalog Section -->
<div class="container py-5" id="catalog">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Our Collection</h2>
        <!-- TODO: Display dynamic book count here -->
        <p class="text-secondary mb-0">Explore all @Model.Count() books in our catalog</p>
    </div>

    <!-- Books Grid -->
    <!-- TODO: Loop through products collection here -->

    @if (Model.Any())
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var prod in Model)
            {
                <!-- Sample Book Card - This is a template, duplicate this inside the loop -->
                <div class="col">
                    <div class="card h-100 border shadow-sm book-card">
                        <!-- TODO: Add dynamic link to Details page with asp-action and asp-route-productId -->
                        <a asp-action="Details" asp-route-productId="@prod.Id" class="text-decoration-none">
                            <div style="aspect-ratio: 3/4; overflow: hidden;">
                                @if (string.IsNullOrEmpty(prod.ImageUrl))
                                {
                                    <!-- TODO: Display product image if available, otherwise show placeholder -->
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-light">
                                        <i class="bi bi-book display-3 text-secondary"></i>
                                    </div>
                                }
                                else
                                {

                                    <img src="@prod.ImageUrl" class="w-100 h-100" style="object-fit:cover" />
                                }
                            </div>
                        </a>
                        <div class="card-body">
                            <!-- TODO: Display product category -->
                            <span class="badge bg-secondary mb-2">@prod.Category.Name</span>
                            <h6 class="card-title fw-semibold mb-2" style="min-height: 2.5rem;">
                                <!-- TODO: Add link to details page and display product title -->
                                <a href="#" class="text-decoration-none text-dark">
                                    @prod.Title
                                </a>
                            </h6>
                            <!-- TODO: Display product author -->
                            <p class="text-secondary small mb-2">by @prod.Author</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <!-- TODO: Display product price -->
                                    <span class="fw-bold text-success">@prod.Price100.ToString("c")</span>
                                    @if(prod.ListPrice > prod.Price100)
                                    {
                                        <!-- TODO: Display list price if greater than current price -->
                                        <small class="text-decoration-line-through text-muted ms-1">@prod.ListPrice.ToString("c")</small>
                                    }
                                </div>
                                <!-- TODO: Link to details page with product ID -->
                                <a asp-action="Details" asp-route-productId="@prod.Id" class="btn btn-sm btn-outline-dark">
                                    View
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<partial name="_Newsletter" />
