@using BulkyBook.Models
@model Product
<div class="container-fluid py-4">
    <a class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 mb-3" asp-controller="Product" asp-action="Index">
        <i class="bi bi-arrow-left"></i> Back to products
    </a>
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4" style="background: linear-gradient(to right, #065f46, #282828, #191414);">
            <h5 class="mb-0 fw-bold"><i class="bi bi-plus-lg me-2"></i>Create Product</h5>
            <p class="mb-0 small" style="color: #1DB954;">Add a new product</p>
        </div>
        <div class="card-body p-4">
            <form method="post">

                <div class="col-lg-8">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Title" class=" form-label fw-semibold small"></label>
                            <input type="text" name="Title" asp-for="Title" class="form-control" placeholder="Enter Product Title" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class=" form-label fw-semibold small"></label>
                            <input type="text" name="Description" asp-for="Description" class="form-control" placeholder="Enter Product Description" />
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="ISBN" class=" form-label fw-semibold small"></label>
                            <input type="text" name="ISBN" asp-for="ISBN" class="form-control" placeholder="Enter ISBN" />
                            <span asp-validation-for="ISBN" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="Author" class=" form-label fw-semibold small"></label>
                            <input type="text" name="Author" asp-for="Author" class="form-control" placeholder="Enter author name" />
                            <span asp-validation-for="Author" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="border rounded p-3 mt-3 bg-light">
                        <p class="text-uppercase fw-semibold text-secondary mb-3" style="font-size:0.65rem; letter-spacing: 0.1em;">Pricing</p>
                        <div class="row g-3">
                        
                        <div class="col-6 col-md-3">
                            <label asp-for="ListPrice" class=" form-label fw-semibold small"></label>
                            <input type="text" name="ListPrice" asp-for="ListPrice" class="form-control" placeholder="Enter ListPrice" />
                            <span asp-validation-for="ListPrice" class="text-danger small"></span>
                        </div>
                        <div class="col-6 col-md-3">
                            <label asp-for="Price" class=" form-label fw-semibold small"></label>
                            <input type="text" name="Price" asp-for="Price" class="form-control" placeholder="Enter Price" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="col-6 col-md-3">
                            <label asp-for="Price50" class=" form-label fw-semibold small"></label>
                            <input type="text" name="Price50" asp-for="Price50" class="form-control" placeholder="Enter Price50" />
                            <span asp-validation-for="Price50" class="text-danger small"></span>
                        </div>
                        <div class="col-6 col-md-3">
                            <label asp-for="Price100" class=" form-label fw-semibold small"></label>
                            <input type="text" name="Price100" asp-for="Price100" class="form-control" placeholder="Enter Price100" />
                            <span asp-validation-for="Price100" class="text-danger small"></span>
                        </div>
                    </div>
                    </div>
                    <div class="mt-3">
                         <label asp-for="CategoryId" class=" form-label fw-semibold small"></label>
                            <select asp-for="CategoryId" asp-items="@(ViewBag.categoryList)" class="form-control">
                                <option disabled selected>--Select Category--</option>    
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-lg-4">
                    @* Images *@
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-accent fw-semibold">Create Product</button>
                    <a class="btn btn-light fw-medium" asp-controller="Product" asp-action="Index">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial"></partial>
    }